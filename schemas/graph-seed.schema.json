{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "oneOf": [
    {
      "not": {
        "required": [
          "edge"
        ]
      },
      "properties": {
        "record_type": {
          "const": "artifact_node"
        }
      },
      "required": [
        "record_type",
        "artifact"
      ]
    },
    {
      "not": {
        "required": [
          "artifact"
        ]
      },
      "properties": {
        "record_type": {
          "const": "artifact_edge"
        }
      },
      "required": [
        "record_type",
        "edge"
      ]
    }
  ],
  "properties": {
    "artifact": {
      "$ref": "artifact-node.schema.json"
    },
    "edge": {
      "$ref": "artifact-edge.schema.json"
    },
    "record_type": {
      "enum": [
        "artifact_node",
        "artifact_edge"
      ]
    }
  },
  "required": [
    "record_type"
  ],
  "title": "L9 Graph Seed JSONL Record",
  "type": "object"
}
